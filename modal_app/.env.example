# Lab 21 — template biến môi trường. Copy thành `.env` rồi paste key thật.
#   cp .env.example .env   (hoặc dùng file .env đã tạo sẵn)
#
# .env bị gitignore; .env.example thì commit được (không chứa secret).

# Bắt buộc cho Option B (push HF Hub). Token quyền Write:
#   https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_USERNAME=

# Tuỳ chọn — stretch goal W&B:  https://wandb.ai/authorize
WANDB_API_KEY=

# Config overrides (tuỳ chọn)
# MODEL_NAME=unsloth/Qwen2.5-7B-Instruct-bnb-4bit
# DATASET_NAME=5CD-AI/Vietnamese-alpaca-gpt4-gg-translated
# N_SAMPLES=500
# MAX_SEQ_CAP=2048
# NUM_EPOCHS=3
# EFFECTIVE_BATCH=8
# DO_GGUF=1
# GPU_COST_USD_PER_HOUR=1.50
